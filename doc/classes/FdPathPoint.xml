<?xml version="1.0" encoding="UTF-8" ?>
<class name="FdPathPoint" inherits="Resource" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
		fdsim 路线上的一个点，包含 position 与 rotation。
	</brief_description>
	<description>
		[FdPath3D] 中的一个点。每行一个点，含位置 [member position] 与旋转 [member rotation]（欧拉角，单位：度，YXZ 顺序）。
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="position" type="Vector3" setter="set_position" getter="get_position" default="Vector3(0, 0, 0)">
			点的位置。
		</member>
		<member name="rotation" type="Vector3" setter="set_rotation_deg" getter="get_rotation_deg" default="Vector3(0, 0, 0)">
			点的欧拉角（度）。
		</member>
	</members>
</class>
